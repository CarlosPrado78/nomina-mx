{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NominaMX",
  "version": "0.1.0",
  "identifier": "com.nomina.mx",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NominaMX",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi"],
    "icon": []
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:nomina.db"]
    }
  }
}